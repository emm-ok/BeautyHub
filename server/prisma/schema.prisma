// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ProductVerificationStatus {
  VERIFIED
  NOT_VERIFIED
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

enum SkinType {
  NORMAL
  DRY
  OILY
  COMBINATION
  SENSITIVE
  ALL
  UNKNOWN
}

enum ProductConcern {
  ACNE_PRONE
  DARK_SPOTS
  UNEVEN_SKIN_TONE
  DRYNESS
  OILY_SKIN
  SENSITIVE_SKIN
  ROUGH_SKIN
  BUMPY_SKIN
  BODY_ACNE
  ANTI_AGING
  GENERAL_SKINCARE
  GENERAL_BODY_CARE
}

enum ProductCategory {
  CLEANSER
  SERUM
  MOISTURISER
  SUNSCREEN
  TONER
  BODY_CARE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  FAILED
  CANCELLED
}

enum WhatsAppNotificationType {
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_DISPATCHED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// USER
model User {
  id      String @id @default(uuid())
  clerkId String @unique

  email String  @unique
  name  String?

  phone  String?
  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cart                  Cart?
  orders                Order[]
  addresses             CustomerAddress[]
  whatsappNotifications WhatsAppNotification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// CUSTOMER ADDRESSES
model CustomerAddress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          AddressType @default(HOME)
  label         String?
  recipientName String
  phone         String

  addressLine1 String
  addressLine2 String?
  landmark     String?

  state String
  city  String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([state])
  @@map("customer_addresses")
}

// DELIVERY REGIONS
model DeliveryRegion {
  id String @id @default(uuid())

  state String @unique

  deliveryFee Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@index([isActive])
  @@map("delivery_regions")
}

// PRODUCT CATALOGUE
model Category {
  id String @id @default(uuid())

  name        ProductCategory
  slug        String          @unique
  description String?
  imageUrl    String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id String @id @default(uuid())

  name        String
  slug        String @unique
  description String

  brand String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Pricing

  price     Decimal @db.Decimal(12, 2)
  salePrice Decimal @db.Decimal(12, 2)

  discountType DiscountType @default(NONE)

  discountValue Decimal? @db.Decimal(12, 2)

  // Inventory

  stockQuantity Int @default(0)

  lowStockThreshold Int @default(5)

  // Product status

  status ProductStatus @default(ACTIVE)

  // Admin manually controls this.
  // No external verification workflow exists.
  verificationStatus ProductVerificationStatus @default(NOT_VERIFIED)

  // Product education / discovery data

  howToUse String?

  keyIngredients String?

  benefits String?

  suitabilityNotes String?

  warnings String?

  skinTypes SkinType[]

  concerns ProductConcern[]

  // Product metadata

  size String?
  unit String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
  @@index([price])
  @@index([salePrice])
  @@map("products")
}

// PRODUCT IMAGES
model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  public_id String

  altText String?

  sortOrder Int @default(0)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// SHOPPING CART
model Cart {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ORDERS
model Order {
  id String @id @default(uuid())

  // Human-friendly order number.
  // Example: BH-2026-000123
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Financial snapshot

  subtotal Decimal @db.Decimal(12, 2)

  deliveryFee Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  currency String @default("NGN")

  // Order state

  status OrderStatus @default(PENDING_PAYMENT)

  // Contact snapshot

  customerName  String
  customerEmail String
  customerPhone String

  whatsappPhone String?

  // Timestamps

  paidAt       DateTime?
  processedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations

  items OrderItem[]

  payments Payment[]

  delivery Delivery?

  deliveryAddressId String?
  deliveryAddress   CustomerAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  statusHistory OrderStatusHistory[]

  whatsappNotifications WhatsAppNotification[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@map("orders")
}

// ORDER ITEMS
model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  // Snapshot of the product price at purchase time.
  // This MUST NOT change when the product's current price changes.
  unitPrice Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)

  // Snapshot product information.
  // Useful if the product is later renamed.
  productName String

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// PAYMENTS
model Payment {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider PaymentProvider

  status PaymentStatus @default(PENDING)

  // Provider transaction/reference ID.
  reference String @unique

  amount Decimal @db.Decimal(12, 2)

  currency String @default("NGN")

  // Optional provider-specific transaction ID.
  providerTransactionId String?

  paidAt DateTime?

  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

// DELIVERY
model Delivery {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  regionId String
  region   DeliveryRegion @relation(fields: [regionId], references: [id], onDelete: Restrict)

  status DeliveryStatus @default(PENDING)

  // Delivery address snapshot

  recipientName String
  phone         String

  addressLine1 String
  addressLine2 String?
  landmark     String?

  state String
  city  String

  // Tracking

  trackingReference String?

  estimatedDeliveryDate DateTime?

  dispatchedAt DateTime?
  deliveredAt  DateTime?

  deliveryNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([status])
  @@index([trackingReference])
  @@map("deliveries")
}

// ORDER STATUS HISTORY
model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  note String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
  @@map("order_status_history")
}

// WHATSAPP NOTIFICATIONS
model WhatsAppNotification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type WhatsAppNotificationType

  status WhatsAppNotificationStatus @default(PENDING)

  recipientPhone String

  // WhatsApp provider message ID.
  providerMessageId String?

  messageContent String?

  failureReason String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@map("whatsapp_notifications")
}
